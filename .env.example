# Required for Q&A (https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# API
API_HOST=0.0.0.0
API_PORT=8000

# Text extraction languages (comma-separated)
OCR_LANGUAGE=ar,en

# Frontend (Vite) — use VITE_ prefix; see frontend/.env.example if present
VITE_API_URL=http://localhost:8000

# --- Optional: IBM BPM pooled HTTP client ---
# BPM_BASE_URL=https://your-bpm-host:port/your-root
# BPM_POOL_CONNECTIONS=10
# BPM_POOL_MAXSIZE=32
# BPM_HTTP_TIMEOUT_SEC=120
# BPM_USERNAME=
# BPM_PASSWORD=
# BPM_BEARER_TOKEN=

# --- Optional: FileNet / content REST pooled client ---
# FILENET_BASE_URL=https://your-filenet-proxy-host/your-root
# FILENET_POOL_CONNECTIONS=10
# FILENET_POOL_MAXSIZE=32
# FILENET_HTTP_TIMEOUT_SEC=120
# FILENET_USERNAME=
# FILENET_PASSWORD=
# FILENET_BEARER_TOKEN=
